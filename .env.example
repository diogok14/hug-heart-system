# Copie para .env e preencha com SUAS PRÓPRIAS credenciais.
# Nenhuma chave privada é versionada neste repositório.

# Supabase (públicas — podem ir para o bundle do navegador)
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-ou-publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-id>

# Supabase (servidor)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-ou-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Google Maps Platform — chave PRÓPRIA de cada instalação.
# Habilite Geocoding API, Places API (New) e Street View Static API.
GOOGLE_MAPS_API_KEY=<sua-chave>

# Gateway de IA (análise semântica de editais)
LOVABLE_API_KEY=<sua-chave>
